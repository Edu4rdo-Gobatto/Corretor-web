VITE_API_URL=/api
API_PROXY_TARGET=http://localhost:3000
# /api is handled by the front server and forwarded to API_ORIGIN.

# SSR public API origin (no /api prefix); only read on the server
# dev/preview recusam origens remotas para evitar acesso acidental à produção
API_ORIGIN=http://localhost:3000
# Set the canonical production HTTPS origin before enabling indexing
SITE_URL=
SEO_INDEXABLE=false
